+static bool affine_family_audit(const Instance &g, std::string &why) {
+    std::mt19937_64 rng(617751ULL);
+    std::vector<uint8_t> mutable_edge;
+    auto colors = affine_family26(g, rng, &mutable_edge);
+    if (std::count(mutable_edge.begin(), mutable_edge.end(), static_cast<uint8_t>(1)) != 75) {
+        why = "affine family mutable edge count is not 75";
+        return false;
+    }
+    for (size_t s = 0; s < g.six_edges.size(); ++s) {
+        bool has_infinity = false;
+        for (uint8_t v : g.six_vertices[s]) if (v == 25) has_infinity = true;
+        if (has_infinity) continue;
+        uint8_t present = 0;
+        for (uint16_t e : g.six_edges[s]) present |= static_cast<uint8_t>(1u << colors[e]);
+        if (present != 31) {
+            why = "old-only six-set failed finite-slope invariant";
+            return false;
+        }
+    }
+    State st;
+    st.colors = colors;
+    rebuild(g, st);
+    for (int k = 0; k < 150; ++k) {
+        int e;
+        do { e = static_cast<int>(rng() % g.edge_count); } while (!mutable_edge[e]);
+        uint8_t c;
+        do { c = static_cast<uint8_t>(rng() % 5); } while (c == st.colors[e]);
+        int before = st.score;
+        int predicted = delta_recolor(g, st, e, c);
+        apply_recolor(g, st, e, c);
+        int exact = score_full(g, st.colors);
+        if (st.score != exact || exact - before != predicted) {
+            why = "affine-family delta mismatch at move " + std::to_string(k);
+            return false;
+        }
+    }
+    return true;
+}
