+static std::vector<uint8_t> affine_family26(const Instance &g, std::mt19937_64 &rng,
+                                            std::vector<uint8_t> *mutable_edge = nullptr) {
+    if (g.n != 26) throw std::runtime_error("affine_family26 requires n=26");
+    std::vector<uint8_t> colors(g.edge_count, 0);
+    if (mutable_edge) mutable_edge->assign(g.edge_count, 0);
+    for (int e = 0; e < g.edge_count; ++e) {
+        auto [u0, v0] = g.endpoints[e];
+        int u = u0, v = v0;
+        if (v == 25) {
+            colors[e] = static_cast<uint8_t>(rng() % 5);
+            if (mutable_edge) (*mutable_edge)[e] = 1;
+            continue;
+        }
+        int x1 = u % 5, y1 = u / 5, x2 = v % 5, y2 = v / 5;
+        int dx = (x2 - x1 + 5) % 5, dy = (y2 - y1 + 5) % 5;
+        if (dx == 0) {
+            colors[e] = static_cast<uint8_t>(rng() % 5);
+            if (mutable_edge) (*mutable_edge)[e] = 1;
+        } else {
+            colors[e] = static_cast<uint8_t>((dy * inv5(dx)) % 5);
+        }
+    }
+    return colors;
+}
